NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GROQ_API_KEY=your-groq-key

# Optional: Groq model for taste picks (default: llama-3.3-70b-versatile)
# GROQ_TASTE_PICKS_MODEL=llama-3.3-70b-versatile

# Public app URL used for share links (your canonical production URL)
NEXT_PUBLIC_APP_URL=https://get-plate-check.vercel.app

# Vercel cron auth (leaderboard refresh — Vercel sends this automatically when set)
CRON_SECRET=your-random-secret

# Admin dashboard (/admin/metrics)
ADMIN_EMAIL=you@example.com

# In Vercel: paste values WITHOUT quotes. Enable Production + Preview.
